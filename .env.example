# =============================================================================
# Luumu People — variáveis de ambiente
# Copie para .env.local (desenvolvimento). NUNCA faça commit de valores reais.
# Detalhes: docs/environment.md
# =============================================================================

# URL pública da aplicação (sem barra no final). Usada por cookies, CSRF e links de e-mail.
# Na Vercel é opcional: sem ela, usa o domínio de produção ou a URL do preview.
APP_URL=http://localhost:3000

# --- Banco de dados ----------------------------------------------------------
# Desenvolvimento local sem instalar nada: Postgres embarcado (PGlite), que se
# auto-migra e recebe os dados demonstrativos. Para memória volátil: pglite://memory
DATABASE_URL=pglite://.data/pglite

# Preview/produção (Neon): use o endpoint POOLED e os logins de runtime criados
# por `pnpm db:provision-roles` — NUNCA o usuário dono (neondb_owner).
#   DATABASE_URL       → login membro de luumu_app  (dados de negócio, RLS por tenant)
#   DATABASE_URL_AUTH  → login membro de luumu_auth (tabelas de autenticação)
# DATABASE_URL=postgresql://luumu_app_login:***@ep-xxx-pooler.<regiao>.aws.neon.tech/neondb?sslmode=verify-full
# DATABASE_URL_AUTH=postgresql://luumu_auth_login:***@ep-xxx-pooler.<regiao>.aws.neon.tech/neondb?sslmode=verify-full

# Somente para CLI (migrations, seed, provisionamento). NÃO configurar na Vercel.
# DATABASE_URL_MIGRATIONS=postgresql://neondb_owner:***@ep-xxx.<regiao>.aws.neon.tech/neondb?sslmode=verify-full

# --- Autenticação ------------------------------------------------------------
# Segredo de assinatura de sessões/tokens (mín. 32 caracteres). Gere com:
#   openssl rand -base64 48
BETTER_AUTH_SECRET=

# Expiração por ociosidade e duração máxima absoluta da sessão (horas).
SESSION_IDLE_HOURS=8
SESSION_ABSOLUTE_HOURS=12

# --- E-mail transacional -----------------------------------------------------
# Sem RESEND_API_KEY em desenvolvimento, os e-mails são impressos no terminal.
# Em produção é obrigatória.
EMAIL_FROM="Luumu People <nao-responda@seu-dominio.com>"
RESEND_API_KEY=

# --- Seeds e provisionamento (somente CLI) ------------------------------------
# Senha das contas demonstrativas (padrão local: Luumu@Demo2026).
SEED_PASSWORD=
# Senhas dos logins de runtime criados por `pnpm db:provision-roles`.
LUUMU_APP_LOGIN_PASSWORD=
LUUMU_AUTH_LOGIN_PASSWORD=

# --- Observabilidade ---------------------------------------------------------
LOG_LEVEL=info
